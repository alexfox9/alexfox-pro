---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/apps/', label: 'Apps' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Alex</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header>
        <a class="wordmark" href="/" aria-label="Alex, homepage">Alex<span class="domain"> / alexfox.pro</span></a>
        <nav aria-label="Main navigation">
          {links.map(({ href, label }) => (
            <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </header>
      <main id="main">
        <p class="draft">Local review · Content and visual direction in progress</p>
        <slot />
      </main>
      <footer>
        <span>Alex · UX portfolio</span>
        <a href="/apps/">Explore my apps <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </body>
</html>

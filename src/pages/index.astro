---
import Layout from '../layouts/Layout.astro';
---
<Layout title="UX portfolio" description="Alex's UX portfolio and independent apps. Local review draft.">
  <p class="eyebrow">UX portfolio</p>
  <h1>Hi, I’m Alex.</h1>
  <p class="lead">This is the new home for my UX work and the apps I build.</p>
  <div class="actions">
    <a class="primary" href="/work/">Explore my work <span aria-hidden="true">→</span></a>
    <a href="/apps/">See my apps</a>
  </div>
  <section aria-labelledby="work-heading">
    <h2 id="work-heading">Work, with the thinking behind it.</h2>
    <p>Case studies are being prepared. This space will show the problems, decisions, and evidence behind each project.</p>
    <a href="/work/">View the work section</a>
  </section>
</Layout>
